{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "title": "PlayGuard console found",
        "description": "Add **{name}** (console id `{console_id}`)? Its own Home Assistant device (MQTT discovery) is replaced by this integration's, with the same entities, game names, the week's play time and long-term statistics."
      },
      "user": {
        "title": "Add a PlayGuard console",
        "description": "Consoles that publish on the broker are found by themselves. To add one by hand: its id is in PlayGuard › Preferences › Remote access › Console id.",
        "data": {
          "console_id": "Console id",
          "topic_prefix": "Topic prefix"
        },
        "data_description": {
          "console_id": "8 characters, such as 5a0c3e11.",
          "topic_prefix": "playguard, unless sync.conf says otherwise."
        }
      },
      "reconfigure": {
        "title": "Change the topic prefix",
        "description": "The prefix {name} publishes under: `topic_prefix` in PlayGuard's sync.conf.",
        "data": {
          "topic_prefix": "Topic prefix"
        },
        "data_description": {
          "topic_prefix": "playguard, unless sync.conf says otherwise."
        }
      }
    },
    "error": {
      "invalid_console_id": "A console id is 8 characters, 0 to 9 and a to f.",
      "invalid_prefix": "This prefix cannot be part of an MQTT topic.",
      "no_state": "This console has published nothing on the broker under this prefix. Check the console id and the prefix, and that the console's link is up once (PlayGuard › Preferences › Remote access › Status)."
    },
    "abort": {
      "already_configured": "This console is already set up.",
      "invalid_discovery_info": "This message is not a PlayGuard state.",
      "mqtt_not_ready": "The MQTT integration is not set up yet: PlayGuard talks to Home Assistant through it. Set it up first, on the same broker as the console."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "take_over_discovery": "Replace the console's own Home Assistant device"
        },
        "data_description": {
          "take_over_discovery": "Turns the console's MQTT discovery off, so its entities are not there twice. Off: the console publishes its own device again."
        }
      }
    }
  },
